# Copy thành .env rồi điền. KHÔNG commit file .env.

# --- Database ---
DB_PASSWORD=doi_mat_khau_nay
DATABASE_URL=postgresql+psycopg://sysops:doi_mat_khau_nay@db:5432/sysops

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# =========================================================================
# XÁC THỰC — bắt buộc cấu hình trước khi chạy production
# =========================================================================
# dev   : mọi request tự khai danh tính qua header. Ứng dụng TỪ CHỐI KHỞI ĐỘNG
#         nếu AUTH_MODE=dev mà DATABASE_URL không phải SQLite.
# token : bearer token cho service account và người dùng máy
# ldap  : SSO/LDAP công ty cho người dùng, token cho job nền
AUTH_MODE=token

# Bắt buộc khi AUTH_MODE != dev. Sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Danh sách token dạng  email:role:sha256hex,...   (role: viewer|requester|sysops|admin)
# CHỈ chứa hash — token gốc không bao giờ nằm trên server.
# Sinh bằng:  python -m auth mktoken svc-celery@ntq-solution.com.vn sysops
AUTH_TOKENS=

# Đặt false chỉ khi chạy dev không có HTTPS
COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800

# --- LDAP (chỉ khi AUTH_MODE=ldap) ---
LDAP_URI=ldaps://dc.ntq.local:636
LDAP_USER_DN_TEMPLATE={username}@ntq.local
LDAP_EMAIL_TEMPLATE={username}@ntq-solution.com.vn
LDAP_GROUP_BASE_DN=OU=Groups,DC=ntq,DC=local
LDAP_ADMIN_GROUP=SysOps-Admin
LDAP_SYSOPS_GROUP=SysOps-Operators
LDAP_REQUESTER_GROUP=SysOps-Requesters

# --- vCenter (tài khoản READ-ONLY riêng cho portal) ---
VCENTER_HOST=vcenter.ntq.local
VCENTER_USER=svc-sysops-portal@vsphere.local
VCENTER_PASSWORD=
# Đặt true sẽ TẮT kiểm tra chứng chỉ TLS — chỉ dùng khi vCenter còn cert
# tự ký, và hiểu rằng credential có thể bị chặn bắt trên đường truyền.
VCENTER_INSECURE=false

# --- Vault (portal chỉ lưu path, không lưu giá trị secret) ---
VAULT_ADDR=https://vault.internal:8200
VAULT_UI=https://vault.internal

# --- Scanner ---
SCAN_SUBNETS=10.0.76.0/24,10.0.64.0/24,10.0.65.0/24,172.16.0.0/24
SCAN_CONCURRENCY=64
SCAN_TIMEOUT_S=1.0
SCAN_RETENTION_DAYS=90

# --- Email nhắc hạn (bỏ trống = chế độ dry-run, chỉ in ra log) ---
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=sysops@ntq-solution.com.vn

# --- Khác ---
RESERVATION_TTL_MINUTES=30
MAX_RESERVATION_TTL_MINUTES=240
AUTO_CREATE_TABLES=false
LOG_LEVEL=INFO
